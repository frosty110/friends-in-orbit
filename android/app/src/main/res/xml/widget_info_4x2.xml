<?xml version="1.0" encoding="utf-8"?>
<!--
  WIDGET-02: AppWidgetProviderInfo for the "Call suggestions" widget.

  Size (WIDGET-07): placed at 4×2 (targetCell*, Android 12+; minWidth and
  minHeight are the 4×2 fallback, 70n - 30dp per cell). Resizable both ways:
  down to one row or a small square (it then shows one person, like "Next
  call"), up to 4×3 and beyond, where the others get their own rows. Each size
  has its own arrangement (WidgetLayouts.kt, SizeMode.Responsive).

  Previews (WIDGET-09), initialLayout (WIDGET-11) and updatePeriodMillis="0"
  as in widget_info_2x2.xml.

  Glance 1.1.1 has no horizontal scroll, so the others are a static list,
  not a carousel.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_4x2_description"
    android:initialLayout="@layout/widget_loading"
    android:previewLayout="@layout/widget_preview_suggestions"
    android:previewImage="@drawable/widget_preview_4x2"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="110dp"
    android:minResizeHeight="56dp"
    android:maxResizeWidth="530dp"
    android:maxResizeHeight="450dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="0" />
