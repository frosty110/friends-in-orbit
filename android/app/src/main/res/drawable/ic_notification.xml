<?xml version="1.0" encoding="utf-8"?>
<!--
    Status-bar icon for nudges: the Orbit glyph (two rings round a dot), the
    same shape as the launcher icon and its themed monochrome layer, so the
    status bar says who the nudge is from. It used to be a phone handset,
    which read as the dialer's own missed-call icon.
    Android draws only the alpha channel of a small icon: white on clear.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.75"
        android:pathData="M12,12m-9,0a9,9 0,1 0,18 0a9,9 0,1 0,-18 0" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="@android:color/white"
        android:strokeWidth="1.75"
        android:pathData="M12,12m-5,0a5,5 0,1 0,10 0a5,5 0,1 0,-10 0" />
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,12m-1.75,0a1.75,1.75 0,1 0,3.5 0a1.75,1.75 0,1 0,-3.5 0" />
</vector>
