<?xml version="1.0" encoding="utf-8"?>
<!--
    Themed-icon layer (Android 13+): the launcher foreground's two rings and
    dot as one flat shape. The system reads only its alpha and tints it to the
    home screen's palette, so the colour here does not matter; the geometry
    matches ic_launcher_foreground exactly, inside the 66dp safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:strokeColor="#FFFFFFFF" android:strokeWidth="2.5"
        android:fillColor="#00000000"
        android:pathData="M54,54 m-30,0 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0" />
    <path android:strokeColor="#FFFFFFFF" android:strokeWidth="2.5"
        android:fillColor="#00000000"
        android:pathData="M54,54 m-18,0 a18,18 0 1,0 36,0 a18,18 0 1,0 -36,0" />
    <path android:fillColor="#FFFFFFFF"
        android:pathData="M54,54 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0" />
</vector>
