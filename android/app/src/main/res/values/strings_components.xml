<?xml version="1.0" encoding="utf-8"?>
<!--
    Shared component copy, and the chrome words every screen uses.
    Keys are area_what (features/_foundations/voice.md, "Where copy lives").
    Sentence case, no exclamation marks, the voice.md glossary's words.
-->
<resources>

    <!-- Shared actions: buttons, app-bar back arrow, snackbar actions. -->
    <string name="components_action_back">Back</string>
    <string name="components_action_cancel">Cancel</string>
    <string name="components_action_save">Save</string>
    <string name="components_action_done">Done</string>
    <string name="components_action_continue">Continue</string>
    <!-- Snackbar action that reverses the change the snackbar just announced. -->
    <string name="components_action_undo">Undo</string>
    <string name="components_action_archive">Archive</string>
    <string name="components_action_delete">Delete</string>
    <!-- Opens Orbit's own Settings screen (Card view's and Call history's "can't see your
         calls" notices). -->
    <string name="components_action_open_settings">Open settings</string>
    <!-- Opens the phone's settings page for Orbit, where a permission is granted (onboarding,
         the picker's denied state, Settings' permission rows). -->
    <string name="components_action_open_phone_settings">Open phone settings</string>
    <!-- Goes to a person's page. The TalkBack action on Browse and Search rows and on the card. -->
    <string name="components_action_open_details">Open details</string>

    <!-- Second line under Archive in a list's menu (Home, Lists). %1$s: the list's name. -->
    <string name="components_menu_archive_supporting">Hides %1$s from home. You can restore it.</string>

    <!-- Shown when a change could not be written. Rules: a failed write always tells the user. -->
    <string name="components_snackbar_save_failed">Couldn\'t save your change</string>

    <!-- Snackbars several screens show after changing one person (Contact detail, Browse,
         the contact picker, Settings > Ignored), each with Undo. %1$s: the person's name. -->
    <string name="components_snackbar_ignored">Ignored %1$s</string>
    <!-- Reverses Ignore: the person is back in their lists. Replaces "Restored", which Settings >
         Ignored and the picker still read until they switch; both keys stay until then. -->
    <string name="components_snackbar_unignored">Unignored %1$s</string>
    <string name="components_snackbar_restored">Restored %1$s</string>
    <string name="components_snackbar_unpaused">Unpaused %1$s</string>
    <!-- After pausing one person: no nudges and no suggestions for a while. One sentence per
         length of pause. %1$s: the person's name. -->
    <string name="components_snackbar_paused_week">Paused %1$s for 1 week</string>
    <string name="components_snackbar_paused_month">Paused %1$s for 1 month</string>
    <!-- The same words as the option the user just chose ("Until you unpause"). -->
    <string name="components_snackbar_paused_indefinitely">Paused %1$s until you unpause</string>
    <!-- The same after pausing several people at once (Browse). %1$d: how many. -->
    <plurals name="components_snackbar_paused_people_week">
        <item quantity="one">Paused %1$d person for 1 week</item>
        <item quantity="other">Paused %1$d people for 1 week</item>
    </plurals>
    <plurals name="components_snackbar_paused_people_month">
        <item quantity="one">Paused %1$d person for 1 month</item>
        <item quantity="other">Paused %1$d people for 1 month</item>
    </plurals>
    <plurals name="components_snackbar_paused_people_indefinitely">
        <item quantity="one">Paused %1$d person until you unpause</item>
        <item quantity="other">Paused %1$d people until you unpause</item>
    </plurals>
    <!-- After moving or copying people into another list (Browse, the contact picker).
         %1$d: how many people, %2$s: the list's name. The noun is said ("1 person",
         "3 people"), as in "Ignored 3 people". -->
    <plurals name="components_snackbar_moved">
        <item quantity="one">Moved 1 person to %2$s</item>
        <item quantity="other">Moved %1$d people to %2$s</item>
    </plurals>
    <plurals name="components_snackbar_copied">
        <item quantity="one">Copied 1 person to %2$s</item>
        <item quantity="other">Copied %1$d people to %2$s</item>
    </plurals>

    <!-- The one "Pause for how long?" sheet (Contact detail, Browse). -->
    <string name="components_pause_title">Pause for how long?</string>
    <string name="components_pause_week">1 week</string>
    <string name="components_pause_month">1 month</string>
    <!-- The open-ended choice. The status line and the snackbar use the same words. -->
    <string name="components_pause_until_unpause">Until you unpause</string>

    <!-- A stat that has no value yet (Card view, Contact detail). Words, never a dash. -->
    <string name="components_stat_never_called">Never called</string>
    <string name="components_stat_not_enough_calls">Not enough calls yet</string>

    <!-- Privacy curtain: stands in for a person's or list's real name while the app is
         covered (app switcher, someone looking over a shoulder). -->
    <string name="components_curtain_contact">Contact</string>
    <string name="components_curtain_list">List</string>
    <string name="components_curtain_someone">Someone</string>

    <!-- Banner after the user returns from a call. -->
    <string name="components_post_call_heading_generic">You just made a call</string>
    <!-- %1$s: the person's name. -->
    <string name="components_post_call_heading_named">You just called %1$s</string>
    <string name="components_post_call_body">Add a note while it\'s fresh</string>
    <string name="components_post_call_add_note">Add a note</string>
    <string name="components_post_call_dismiss">Dismiss</string>
    <!-- TalkBack label for the X that closes a snackbar. -->
    <string name="components_snackbar_dismiss">Dismiss</string>

    <!-- A person row in Browse and Search. %1$s: the person's first name. -->
    <string name="components_browse_row_call">Call %1$s</string>
    <!-- Screen-reader words for the small dot that marks someone worth a call now. Not "Due":
         the app says nothing that reads as a deadline (voice.md). -->
    <string name="components_browse_row_due">Worth a call now</string>
    <string name="components_browse_row_never_called">Never called</string>
    <!-- %1$s: how long ago, for example "3 days ago". -->
    <string name="components_browse_row_last_call">Last call: %1$s</string>

    <string name="components_search_clear">Clear search</string>
    <!-- Screen-reader name of the placeholder shapes shown while a list loads. -->
    <string name="components_loading">Loading</string>
    <!-- Short notices when the phone has no app to hand a call or a contact to
         (a tablet with no dialer, say). Factual, no apology. -->
    <string name="components_toast_no_dialer">No dialer app installed</string>
    <string name="components_toast_no_contacts_app">No contacts app installed</string>
    <!-- Screen-reader name of the small "i" button that explains the thing next to it. -->
    <string name="components_info_tip_label">About this</string>


    <!-- Shared error state (rubric D6): what happened, that nothing is lost, and Retry. -->
    <string name="components_error_body">Nothing is lost. Try again in a moment.</string>
    <string name="components_error_retry">Try again</string>

    <!-- The button that opens this app's page in the phone's own settings (a permission the
         OS will no longer ask about, notifications switched off). Sentence case. -->
    <string name="components_action_open_phone_settings">Open phone settings</string>
    <!-- After reversing an ignore (Settings > Ignored, the picker), with Undo. %1$s: the person's name. -->
    <string name="components_snackbar_unignored">Unignored %1$s</string>
</resources>
