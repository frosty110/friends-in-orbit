<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings, including Ignored, export and import.
    Keys are area_what (features/_foundations/voice.md, "Where copy lives").
-->
<resources>

    <string name="settings_title">Settings</string>

    <!-- Section titles. -->
    <string name="settings_section_appearance">Appearance</string>
    <string name="settings_section_permissions">Permissions</string>
    <string name="settings_section_contacts">Contacts</string>
    <string name="settings_section_call_history">Call history</string>
    <string name="settings_section_data">Data</string>
    <string name="settings_section_about">About</string>

    <!-- Permissions rows: the Android permission, its state, and what the button does. -->
    <string name="settings_perm_contacts">Contacts</string>
    <string name="settings_perm_call_log">Call log</string>
    <string name="settings_perm_notifications">Notifications</string>
    <string name="settings_perm_status_allowed">Allowed</string>
    <string name="settings_perm_status_not_allowed">Not allowed</string>
    <string name="settings_perm_status_off">Off in your phone\'s settings</string>
    <string name="settings_perm_allow">Allow</string>
    <string name="settings_perm_open_android_settings">Open Android Settings</string>

    <!-- Sync rows (Contacts and Call history). %1$s: a relative time, for example "5 minutes ago". -->
    <string name="settings_sync_never">Never synced.</string>
    <string name="settings_sync_last">Last synced %1$s</string>
    <string name="settings_sync_now">Sync now</string>
    <string name="settings_syncing">Syncing…</string>

    <!-- How far back to read the call log. -->
    <string name="settings_import_range">Import range</string>
    <string name="settings_import_range_sub">How far back to read</string>
    <plurals name="settings_import_range_months">
        <item quantity="one">%1$d month</item>
        <item quantity="other">%1$d months</item>
    </plurals>
    <plurals name="settings_import_range_years">
        <item quantity="one">%1$d year</item>
        <item quantity="other">%1$d years</item>
    </plurals>
    <plurals name="settings_import_range_days">
        <item quantity="one">%1$d day</item>
        <item quantity="other">%1$d days</item>
    </plurals>

    <!-- Data rows. -->
    <string name="settings_export_title">Export my data</string>
    <string name="settings_export_sub">Encrypted JSON, password protected</string>
    <string name="settings_import_title">Import backup</string>
    <string name="settings_import_sub">Replace what\'s here with an exported file</string>
    <string name="settings_reset_title">Reset Orbit</string>
    <string name="settings_reset_sub">Erase every list, contact, and note on this phone</string>

    <!-- People the user chose to hide from suggestions. -->
    <string name="settings_ignored_title">Ignored</string>
    <plurals name="settings_ignored_count">
        <item quantity="one">%1$d ignored</item>
        <item quantity="other">%1$d ignored</item>
    </plurals>
    <string name="settings_ignored_none">No ignored contacts</string>
    <string name="settings_ignored_empty_body">Hidden from surfacing, history kept</string>
    <string name="settings_ignored_unignore">Un-ignore</string>
    <!-- Under an ignored person's name. %1$s: when, for example "today" or "3 days ago". -->
    <string name="settings_ignored_relative">Ignored %1$s</string>

    <string name="settings_call_history_title">Call history</string>
    <string name="settings_call_history_sub">Every call to people on your lists</string>

    <!-- Snackbars after export and import. -->
    <string name="settings_export_saved">Saved your encrypted backup.</string>
    <string name="settings_export_failed">Couldn\'t save the file. Try again?</string>
    <string name="settings_import_restored">Backup restored.</string>
    <string name="settings_import_unreadable">That file couldn\'t be read. Check it\'s an Orbit backup.</string>
    <string name="settings_import_too_new">This backup was made by a newer version of Orbit. Update Orbit first.</string>
    <string name="settings_import_failed">Couldn\'t restore the backup. Nothing was changed.</string>

    <!-- About. -->
    <!-- %1$s: the version number, for example "1.4.0". -->
    <string name="settings_about_version">Version %1$s</string>
    <string name="settings_about_feedback">Send feedback</string>
    <string name="settings_about_privacy">Privacy policy</string>
    <string name="settings_about_privacy_sub">Read how Orbit handles your data</string>
    <string name="settings_about_source">Source code</string>
    <string name="settings_about_licenses">Open source licenses</string>
    <string name="settings_about_licenses_sub">What we built on</string>
    <string name="settings_licenses_close">Close</string>

    <!-- Reset confirmation. -->
    <string name="settings_reset_dialog_title">Reset Orbit?</string>
    <string name="settings_reset_dialog_body">Every list, contact, note, and call record on this phone will be erased. Your phone\'s contacts and call log are not touched.</string>
    <string name="settings_reset_confirm">Reset</string>

    <!-- Restore-from-backup confirmation. %1$s: "4 lists", %2$s: "52 contacts". -->
    <string name="settings_import_confirm_title">Restore this backup?</string>
    <string name="settings_import_confirm_body">This replaces everything in Orbit with the backup: %1$s and %2$s. What\'s on this phone now will be erased.</string>
    <plurals name="settings_import_confirm_lists">
        <item quantity="one">%1$d list</item>
        <item quantity="other">%1$d lists</item>
    </plurals>
    <plurals name="settings_import_confirm_contacts">
        <item quantity="one">%1$d contact</item>
        <item quantity="other">%1$d contacts</item>
    </plurals>
    <string name="settings_import_confirm_replace">Replace</string>

    <!-- Where the picker's groups ("Commonly called", "Rarely called", ...) begin. -->
    <string name="settings_thresholds_title">Groups when adding people</string>
    <string name="settings_thresholds_row_sub">Where Commonly called, Rarely called and the others begin</string>
    <string name="settings_thresholds_body">When you add people to a list, Orbit sorts your contacts into these groups. Choose where each one begins.</string>
    <string name="settings_thresholds_commonly">Commonly called: the top</string>
    <string name="settings_thresholds_rarely">Rarely called: the bottom</string>
    <string name="settings_thresholds_percent_helper">Percent of the contacts you\'ve called</string>
    <string name="settings_thresholds_recently_added">Recently added</string>
    <string name="settings_thresholds_recently_added_helper">Days since Orbit first saw them</string>
    <string name="settings_thresholds_long_gap">Long gap</string>
    <string name="settings_thresholds_long_gap_helper">Days since your last call</string>
    <!-- Unit after a percentage value. -->
    <string name="settings_thresholds_percent_unit" formatted="false">%</string>
    <!-- Unit after a number of days. -->
    <plurals name="settings_thresholds_days_unit">
        <item quantity="one">day</item>
        <item quantity="other">days</item>
    </plurals>
    <string name="settings_thresholds_overlap" formatted="false">These two bands overlap: together they can\'t be more than 100%.</string>
    <!-- Stepper buttons. %1$s: the setting's label. -->
    <string name="settings_thresholds_decrease">Decrease %1$s</string>
    <string name="settings_thresholds_increase">Increase %1$s</string>

    <!-- Appearance. -->
    <string name="settings_appearance_theme">Theme</string>
    <string name="settings_appearance_theme_sub">Pick a color that feels like you</string>
    <string name="settings_appearance_light_dark">Light &amp; dark</string>
    <string name="settings_appearance_accent">Accent</string>
    <string name="settings_appearance_match_theme">Match theme</string>
    <!-- %1$s: a theme name, for example "Using the Warm accent". -->
    <string name="settings_appearance_accent_from_theme">Using the %1$s accent</string>
    <string name="settings_appearance_accent_custom">Custom accent</string>
    <!-- Screen-reader name of the accent colour slider. -->
    <string name="settings_appearance_accent_slider">Accent colour</string>
    <!-- Screen-reader name of a theme swatch. %1$s: the theme name. -->
    <string name="settings_appearance_theme_a11y">%1$s theme</string>
    <string name="settings_appearance_theme_selected_a11y">%1$s theme, selected</string>

    <!-- Colour names the screen reader says for the accent slider's value. -->
    <string name="settings_hue_red">Red</string>
    <string name="settings_hue_orange">Orange</string>
    <string name="settings_hue_yellow">Yellow</string>
    <string name="settings_hue_green">Green</string>
    <string name="settings_hue_teal">Teal</string>
    <string name="settings_hue_blue">Blue</string>
    <string name="settings_hue_violet">Violet</string>
    <string name="settings_hue_magenta">Magenta</string>

    <!-- Theme names (Settings → Appearance). Wallpaper takes its colour from the phone's wallpaper. -->
    <string name="settings_theme_warm">Warm</string>
    <string name="settings_theme_cool">Cool</string>
    <string name="settings_theme_forest">Forest</string>
    <string name="settings_theme_plum">Plum</string>
    <string name="settings_theme_mono">Mono</string>
    <string name="settings_theme_wallpaper">Wallpaper</string>
    <!-- Light, dark, or follow the phone's setting. -->
    <string name="settings_dark_mode_system">System</string>
    <string name="settings_dark_mode_light">Light</string>
    <string name="settings_dark_mode_dark">Dark</string>

    <!-- Export: choose a password for the encrypted file. -->
    <string name="settings_export_sheet_title">Export your data</string>
    <string name="settings_export_sheet_body">We\'ll save an encrypted file of your lists, contacts, call history, notes, and rule overrides. Pick a strong password: we don\'t store it, and we can\'t recover it.</string>
    <string name="settings_password">Password</string>
    <string name="settings_password_hint">At least 8 characters.</string>
    <string name="settings_password_too_short">Use 8 or more characters.</string>
    <string name="settings_password_confirm">Type it again</string>
    <string name="settings_password_mismatch">Passwords don\'t match.</string>
    <string name="settings_export_cta">Export</string>

    <!-- Import: enter the password chosen at export. -->
    <string name="settings_import_sheet_title">Open your backup</string>
    <string name="settings_import_sheet_body">Enter the password you chose when you exported this file.</string>

    <!-- The screen could not read its data; shown with Try again. -->
    <string name="settings_error_title">Orbit couldn\'t load your settings</string>
</resources>
