<?xml version="1.0" encoding="utf-8"?>
<!--
    The two pickers: people into a list (contact picker, also used to re-link a
    person whose phone contact vanished; its move and copy modes are route-only
    with no caller), and lists for one person (list picker). Their commit
    snackbars show on whatever screen the picker returns to.
    Keys are area_what (features/_foundations/voice.md, "Where copy lives").
    "Contacts" only for the phone's own address book; people in Orbit are people.
    The words every screen shares (Try again, "Nothing is lost. Try again in a
    moment.", Open phone settings, "Unignored {name}") live in
    strings_components.xml, not here.
-->
<resources>

    <!-- Contact picker app bar, by mode. %1$d: how many people are selected. -->
    <string name="picker_title_add">Add people</string>
    <plurals name="picker_title_move">
        <item quantity="one">Move %1$d person</item>
        <item quantity="other">Move %1$d people</item>
    </plurals>
    <plurals name="picker_title_copy">
        <item quantity="one">Copy %1$d person</item>
        <item quantity="other">Copy %1$d people</item>
    </plurals>
    <!-- Linking a person whose phone contact was deleted to another phone contact. -->
    <string name="picker_title_relink">Re-link contact</string>

    <!-- The error state's title; its body and "Try again" are the shared components keys. -->
    <string name="picker_error_title">Couldn\'t load your contacts</string>

    <string name="picker_search_hint">Search name or number</string>
    <!-- Under the filter chips when some are greyed out. -->
    <string name="picker_filters_need_calls">Filters like “long gap” wake up once Orbit has your call history.</string>
    <string name="picker_filters_greyed">Grayed-out filters have no matches right now.</string>
    <!-- %1$d: the most the picker selects at once. -->
    <plurals name="picker_select_all_capped">
        <item quantity="one">Over %1$d match. Narrow the search to select them all.</item>
        <item quantity="other">Over %1$d matches. Narrow the search to select them all.</item>
    </plurals>
    <plurals name="picker_select_all_matching">
        <item quantity="one">Select the %1$d match</item>
        <item quantity="other">Select all %1$d matches</item>
    </plurals>

    <!-- The list area is empty, and why. Each state says what is true and offers the
         next step. -->
    <!-- %1$s: what the user typed. Use your language's quotation marks. -->
    <string name="picker_no_matches_query_title">Nothing matches “%1$s”</string>
    <string name="picker_no_matches_filters_title">Nothing matches these filters</string>
    <string name="picker_no_matches_query_body">Try a shorter name, part of a number, or one filter fewer.</string>
    <string name="picker_no_matches_filters_body">Try removing a filter.</string>
    <!-- Add mode: every phone contact is already on the target list. %1$s: the list's
         name ("List" under the privacy curtain). -->
    <string name="picker_everyone_on_list_title">Everyone in your contacts is already on %1$s</string>
    <!-- No filter is active, but everyone left is ignored; the action is "Show ignored". -->
    <string name="picker_everyone_ignored_title">Everyone here is ignored</string>
    <!-- Re-link mode: no other phone contact the person could be linked to. -->
    <string name="picker_relink_none_title">No other phone contacts to link to</string>
    <!-- Choosing people for a list that New list has not made yet (LIST-28), and Orbit has
         no one from the phone's contacts to offer. -->
    <string name="picker_collect_none_title">No people to add yet</string>

    <!-- Sort menu. %1$s: the current order, one of the options below. -->
    <string name="picker_sort_label">Sort: %1$s</string>
    <string name="picker_sort_change">Change the order</string>
    <string name="picker_sort_alphabetical">Alphabetical</string>
    <string name="picker_sort_most_called">Most called</string>
    <string name="picker_sort_recently_called">Recently called</string>
    <string name="picker_sort_recently_added">Recently added</string>
    <!-- The action of the message shown when everyone left is ignored. -->
    <string name="picker_show_ignored">Show ignored</string>
    <!-- Screen-reader name of the eye icon beside Sort, a switch that shows the people you
         ignore when on and hides them when off. TalkBack adds "on" or "off". -->
    <string name="picker_show_ignored_toggle">Show ignored people</string>

    <!-- The list or person the picker was opened for is not there: the id was malformed,
         or the row is gone. The list wording is the one List settings owns
         (lists_config_not_found and its body): "deleted" is Orbit's verb for a list that
         is gone, "removed" is for a person leaving a list. The person wording is the one
         Contact detail uses. -->
    <string name="picker_list_not_found">List not found</string>
    <string name="picker_list_not_found_body">It may have been deleted.</string>
    <string name="picker_person_not_found">This person isn\'t in Orbit anymore</string>
    <string name="picker_person_not_found_body">They may have been removed.</string>

    <string name="picker_no_device_contacts_title">No contacts on this device</string>
    <string name="picker_no_device_contacts_body">Add people to your phone\'s contacts, then come back here.</string>

    <!-- Asking for the contacts permission. The denied state's button is the shared
         "Open phone settings" (strings_components.xml). -->
    <string name="picker_rationale_title">Allow access to your contacts</string>
    <string name="picker_rationale_body">Orbit reads your phone contacts so you can add them to lists. Nothing is uploaded: your contacts stay on this device.</string>
    <string name="picker_rationale_grant">Grant access</string>
    <string name="picker_rationale_not_now">Not now</string>
    <string name="picker_denied_title">Contacts access is off</string>
    <string name="picker_denied_body">Turn it on in your phone\'s settings to add people to your lists. Your contacts stay on this device.</string>

    <!-- Filter chips. -->
    <string name="picker_filter_starred">Starred</string>
    <string name="picker_filter_recently_added">Recently added</string>
    <string name="picker_filter_commonly_called">Commonly called</string>
    <string name="picker_filter_rarely_called">Rarely called</string>
    <string name="picker_filter_never_called">Never called</string>
    <string name="picker_filter_long_gap">Long gap</string>
    <string name="picker_filter_not_on_a_list">Not on a list</string>
    <!-- An applied filter with how many people it matches: "Rarely called · 7". -->
    <string name="picker_filter_applied">%1$s · %2$d</string>
    <string name="picker_filter_on_a_list">On a list</string>
    <!-- %1$s: the list's name. -->
    <string name="picker_filter_on_list">On %1$s</string>
    <string name="picker_filter_no_lists">No lists yet</string>

    <!-- A person row. -->
    <string name="picker_row_never_called">Never called</string>
    <!-- %1$s: how long ago, for example "3 days ago". %2$d: how many calls in all. -->
    <plurals name="picker_row_last_called">
        <item quantity="one">Last called %1$s · %2$d call</item>
        <item quantity="other">Last called %1$s · %2$d calls</item>
    </plurals>
    <!-- The lists this person is on. %1$s: up to three list names, joined by commas. -->
    <string name="picker_row_on_lists">On %1$s</string>
    <!-- %1$s: three list names, %2$d: how many more. -->
    <plurals name="picker_row_on_lists_more">
        <item quantity="one">On %1$s and %2$d more</item>
        <item quantity="other">On %1$s and %2$d more</item>
    </plurals>
    <!-- Under the privacy curtain, which hides list names. %1$d: how many lists. -->
    <plurals name="picker_row_on_lists_count">
        <item quantity="one">On %1$d list</item>
        <item quantity="other">On %1$d lists</item>
    </plurals>
    <string name="picker_row_ignored">Ignored</string>
    <!-- TalkBack's name for the long-press on a row: the glossary's one word for that
         gesture on Home, Browse, Call history and here (voice.md). -->
    <string name="picker_row_more_actions">Quick actions</string>
    <!-- The three-dots button. %1$s: the person's name. -->
    <string name="picker_row_more_actions_for">More actions for %1$s</string>
    <string name="picker_row_open_in_contacts">Open in Contacts</string>
    <string name="picker_row_open_in_contacts_supporting">See their call and message history in your phone\'s contacts app.</string>
    <string name="picker_row_ignore">Ignore</string>
    <string name="picker_row_ignore_supporting">Hide %1$s from Orbit. They stay in your phone\'s contacts.</string>
    <string name="picker_row_unignore">Unignore</string>

    <!-- The commit bar. %1$d: how many, %2$s: the list. The noun is said ("1 person",
         "3 people"), as the snackbars and the title do. The sentences below are what
         TalkBack hears on the commit button. The button shows only its verb: "3 selected"
         sits beside it, the picker is opened from the list it adds to, and the snackbar
         after it names the list ("Added 3 people to Inner orbit"). -->
    <string name="picker_commit_add_short">Add</string>
    <string name="picker_commit_move_short">Move</string>
    <string name="picker_commit_copy_short">Copy</string>
    <plurals name="picker_selected_count">
        <item quantity="one">%1$d selected</item>
        <item quantity="other">%1$d selected</item>
    </plurals>
    <plurals name="picker_commit_add">
        <item quantity="one">Add 1 person to %2$s</item>
        <item quantity="other">Add %1$d people to %2$s</item>
    </plurals>
    <plurals name="picker_commit_move">
        <item quantity="one">Move 1 person to %2$s</item>
        <item quantity="other">Move %1$d people to %2$s</item>
    </plurals>
    <plurals name="picker_commit_copy">
        <item quantity="one">Copy 1 person to %2$s</item>
        <item quantity="other">Copy %1$d people to %2$s</item>
    </plurals>
    <!-- %1$s: the person being re-linked. -->
    <string name="picker_commit_relink">Re-link %1$s</string>
    <!-- New list's People step (LIST-28): the list is made only on "Create list", so the
         button names no list. It takes the chosen people back to the step. -->
    <plurals name="picker_commit_collect">
        <item quantity="one">Add 1 person</item>
        <item quantity="other">Add %1$d people</item>
    </plurals>
    <string name="picker_clear">Clear</string>
    <string name="picker_clear_selection">Clear the selection</string>

    <!-- List picker: the lists to put one person on. %1$s: the person's name. -->
    <string name="picker_lists_title_named">Add %1$s to lists</string>
    <string name="picker_lists_title">Add to lists</string>
    <string name="picker_lists_error_title">Couldn\'t load your lists</string>
    <string name="picker_lists_empty_title">No lists yet</string>
    <string name="picker_lists_empty_body">Make one here and add this person in one more tap.</string>
    <string name="picker_lists_new_list">New list</string>
    <!-- On a list the person is already on; the row cannot be picked. -->
    <string name="picker_lists_already_added">Already added</string>
    <plurals name="picker_lists_commit">
        <item quantity="one">Add to %1$d list</item>
        <item quantity="other">Add to %1$d lists</item>
    </plurals>
    <string name="picker_lists_name_hint">Name this list</string>
    <string name="picker_lists_create">Create</string>

    <!-- Snackbars on the screen the picker returns to, with Undo. %1$d: how many people,
         %2$s: the list. -->
    <plurals name="picker_snackbar_added">
        <item quantity="one">Added 1 person to %2$s</item>
        <item quantity="other">Added %1$d people to %2$s</item>
    </plurals>
    <!-- After the list picker. %1$d: how many lists were actually written. -->
    <plurals name="picker_snackbar_added_to_lists">
        <item quantity="one">Added to %1$d list</item>
        <item quantity="other">Added to %1$d lists</item>
    </plurals>
    <!-- %1$s: the phone contact's name. -->
    <string name="picker_snackbar_relinked">Re-linked to %1$s</string>
    <string name="picker_snackbar_save_failed">Couldn\'t save that</string>
    <string name="picker_snackbar_undo_failed">Couldn\'t undo that</string>
    <string name="picker_snackbar_create_list_failed">Couldn\'t create the list</string>

</resources>
