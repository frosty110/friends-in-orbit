<?xml version="1.0" encoding="utf-8"?>
<!--
    WIDGET-09: what "Next call" looks like in the widget picker (Android 12+
    draws this layout live, in the picker's light or dark mode). It is the
    widget's roomy-square arrangement (WidgetLayout.HERO) with a sample person,
    built from views RemoteViews allows, because the launcher inflates it.
    Initials are sized in dp, like the app's, so they stay inside the circle at
    any font scale. Keep in step with LeadPerson in WidgetContent.kt.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_preview_avatar_lead"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:text="@string/widget_preview_initials"
            android:textColor="@color/widget_preview_avatar_lead_fg"
            android:textSize="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="@string/widget_preview_name"
            android:textColor="@color/widget_preview_fg"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/widget_preview_call"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ph_phone"
                android:tint="@color/widget_preview_on_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:text="@string/widget_call"
                android:textColor="@color/widget_preview_on_accent"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
